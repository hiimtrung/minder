{
  "identifier": "default",
  "description": "Default permissions for Minder desktop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-spawn",
    "shell:allow-stdin-write",
    "shell:allow-kill",
    "shell:allow-execute",
    {
      "identifier": "shell:allow-open",
      "scope": {
        "allow": [
          { "url": "http://**/*" },
          { "url": "https://**/*" }
        ]
      }
    }
  ]
}
