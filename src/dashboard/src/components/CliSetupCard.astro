---
import Card from "./ui/atoms/Card.astro";
---

<Card padding="lg" id="cli-setup-card">
  <div class="flex items-start justify-between gap-3">
    <div>
      <p class="eyebrow">CLI Setup</p>
      <h2 class="font-display mt-2 text-xl font-semibold tracking-tight text-stone-950">
        Connect minder-cli
      </h2>
    </div>
    <button
      id="cli-refresh-status"
      type="button"
      title="Re-check CLI status"
      class="mt-1 rounded-lg border border-stone-200 bg-white px-2.5 py-1.5 text-xs font-medium text-stone-600 transition hover:border-stone-300 hover:text-stone-900"
    >
      Refresh
    </button>
  </div>

  <!-- CLI status indicator -->
  <div class="mt-3 flex items-center gap-2 rounded-xl border border-stone-200 bg-stone-50 px-3 py-2">
    <span id="cli-status-dot" class="inline-block h-2 w-2 flex-shrink-0 rounded-full bg-stone-300"></span>
    <span id="cli-status-text" class="text-sm text-stone-600">Checking CLI…</span>
  </div>

  <div class="mt-5 grid gap-5">

    <!-- Step 1: Install -->
    <div>
      <div class="mb-2 flex items-center gap-2">
        <span class="inline-flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-amber-100 text-[10px] font-bold text-amber-900">1</span>
        <p class="text-sm font-semibold text-stone-800">Install minder-cli</p>
        <span id="cli-installed-badge" class="hidden rounded-full border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700">
          ✓ Installed
        </span>
      </div>
      <div class="grid gap-2">
        <div class="group relative overflow-hidden rounded-xl border border-stone-200 bg-stone-50 px-3 py-2.5">
          <code class="block select-all text-xs font-mono text-stone-800">pip install minder-cli</code>
          <button data-copy-cli="pip" type="button" class="cli-copy-btn">Copy</button>
        </div>
        <p class="px-1 text-xs text-stone-500">
          Or: <code class="rounded bg-stone-100 px-1">uv pip install minder-cli</code> &nbsp;/&nbsp;
          <code class="rounded bg-stone-100 px-1">pipx install minder-cli</code>
        </p>
      </div>
    </div>

    <!-- Step 2: Login -->
    <div>
      <div class="mb-2 flex items-center gap-2">
        <span class="inline-flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-amber-100 text-[10px] font-bold text-amber-900">2</span>
        <p class="text-sm font-semibold text-stone-800">Login with client key</p>
      </div>
      <div class="mb-2">
        <label for="cli-key-input" class="u-field-label mb-1.5">Client API Key</label>
        <input
          id="cli-key-input"
          type="text"
          placeholder="mkc_… (paste or issue a new key above)"
          class="u-input text-xs font-mono"
          autocomplete="off"
          spellcheck="false"
        />
      </div>
      <div class="group relative overflow-hidden rounded-xl border border-stone-200 bg-stone-50 px-3 py-2.5">
        <code id="cli-login-cmd" class="block select-all whitespace-pre-wrap break-all text-xs font-mono text-stone-800"
          >minder login --client-key <span id="cli-key-display" class="text-stone-400">&lt;paste key above&gt;</span> \
  --server-url <span id="cli-server-url">http://localhost:8800</span></code
        >
        <button data-copy-cli="login" type="button" class="cli-copy-btn">Copy</button>
      </div>
    </div>

    <!-- Step 3: Install MCP -->
    <div>
      <div class="mb-2 flex items-center gap-2">
        <span class="inline-flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-amber-100 text-[10px] font-bold text-amber-900">3</span>
        <p class="text-sm font-semibold text-stone-800">Install MCP config</p>
      </div>
      <div class="group relative overflow-hidden rounded-xl border border-stone-200 bg-stone-50 px-3 py-2.5">
        <code class="block select-all text-xs font-mono text-stone-800">minder install --global</code>
        <button data-copy-cli="install-mcp" type="button" class="cli-copy-btn">Copy</button>
      </div>
      <p class="mt-1.5 px-1 text-xs text-stone-500">
        Installs MCP config for all supported IDEs. Use
        <code class="rounded bg-stone-100 px-1">--target vscode</code> to target one IDE.
      </p>
    </div>

  </div>
</Card>

<style>
  .cli-copy-btn {
    position: absolute;
    right: 0.5rem;
    top: 0.5rem;
    border-radius: 0.375rem;
    border: 1px solid rgb(231 229 228);
    background: white;
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: rgb(87 83 78);
    opacity: 0;
    transition: opacity 150ms, color 150ms;
  }
  .group:hover .cli-copy-btn { opacity: 1; }
  .cli-copy-btn:hover { color: rgb(28 25 23); border-color: rgb(168 162 158); }
</style>
