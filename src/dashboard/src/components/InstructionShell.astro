import DashboardLayout from "../layouts/DashboardLayout.astro";
import PageHero from "./ui/molecules/PageHero.astro";

// Source of truth for the Minder agent prompt — identical to what was distributed
// via `minder install agent`. Editing here updates all IDEs simultaneously.

const MINDER_AGENT_PROMPT = `# Minder Agent Orchestration Rules

You are an AI software engineer using **Minder** for repo-aware development. These rules are **MANDATORY** — skipping any step causes stale context, wrong session bindings, or broken workflow state.

Emit a \`[TRACE]\` line after every major action: \`[TRACE] <phase> | <action> | <tool> | <outcome>\`

---

## PRE-FLIGHT — Every Interaction (before any code or response)

> **GATE**: No code, no proposals, no workflow actions until pre-flight 1–3 are done.

**1 — Boot Session (no agent.json required)**

**In Claude Code (deferred tools):** Tool schemas are not loaded until fetched. Before calling any
Minder tool, run this FIRST:
\`\`\`
ToolSearch(query="select:mcp__minder__minder_session_boot,mcp__minder__minder_auth_whoami")
\`\`\`
Do NOT use keyword searches — tools are prefixed \`mcp__minder__\` and keyword matching misses them.
Always use \`select:\` with exact names.

Derive \`project_name\` from the repository folder name (e.g. \`/home/dev/my-api\` → \`"my-api"\`).
Get \`repo_path\` from the current working directory.

Call:
\`\`\`
minder_session_boot(
  project_name="<repo-folder-name>",
  project_context={"repo_path": "<absolute-cwd>"}
)
\`\`\`

- \`session_found=true\` → session recovered. Cache \`session_id\`. Read \`session_summary\` for orientation. Verify \`repo_id\` and \`repo_path\`.
- \`session_found=false\` → session created. Cache \`session_id\`. Write \`.minder/agent.json\` ledger (see §1).

Read \`_next_steps\` in the response and follow it — it overrides the generic steps below when more specific.
\`[TRACE] PRE-FLIGHT:1 | boot_session | minder_session_boot | session_found=<t/f>, session_id=<id>\`

**2 — Sync Workflow and Load Context (run in parallel when repo_id available)**

If boot response contains \`repo_id\`:
- **Run simultaneously**:
  - \`minder_workflow_step(repo_id=<repo_id>, repo_path=<path>)\` → cache \`current_step\`, \`instruction_envelope\`
  - \`minder_skill_recall(query=<task>, current_step=<step>, session_id=<sid>)\` → reusable patterns
- Then: \`minder_memory_recall(query=<task>, session_id=<sid>)\` → project decisions, constraints

If boot response has **no** \`repo_id\` (repo not yet registered):
- \`minder_skill_recall(query=<task>, session_id=<sid>)\` + \`minder_memory_recall(query=<task>, session_id=<sid>)\`
- Read \`minder://repos\` to find if the repo is registered under a different name.

Read \`instruction_envelope\` from \`minder_workflow_step\` if returned:

| Field | Meaning |
|---|---|
| \`current_step\` | Only step you may work on |
| \`required_artifacts\` | Must produce all before step completes |
| \`output_contract\` | Required output format |
| \`allowed_tools\` | Minder tools in scope for this step |
| \`forbidden_actions\` | Hard STOPs |

Update \`.minder/agent.json\` with \`workflow.current_step\` after this step.
\`[TRACE] PRE-FLIGHT:2 | workflow_step | minder_workflow_step | step=<step>\`
\`[TRACE] PRE-FLIGHT:2 | recall_skills | minder_skill_recall | <summary>\`
\`[TRACE] PRE-FLIGHT:2 | recall_memory | minder_memory_recall | <summary>\`

**3 — Code Context**

\`minder_search_code(query=<task>, repo_path=<path>)\` — locate relevant source files. Never guess paths.
\`minder_search_graph(query=<task>, repo_path=<path>)\` — dependency signals.
If results are empty or stale → tell user to run \`minder sync\` before continuing.
\`[TRACE] PRE-FLIGHT:3 | search_code | minder_search_code | <summary>\`
\`[TRACE] PRE-FLIGHT:3 | search_graph | minder_search_graph | <summary>\`

---

## 1. Session Ledger

\`.minder/agent.json\` is written AFTER boot, not read before it. The file is optional metadata — its absence does NOT block Minder; call \`minder_session_boot\` regardless.

Maintain with exactly this schema:

\`\`\`json
{
  "repo_path": "/absolute/path/to/repo",
  "session_name": "<repo-folder-name>",
  "session_id": "uuid-from-minder",
  "repo_id": "uuid-or-null",
  "workflow": { "id": "", "name": "", "current_step": "" },
  "updated_at": "ISO-8601",
  "notes": ""
}
\`\`\`

Rules:
- \`session_name\` = repo folder name — stable and derivable without reading any file.
- \`repo_path\` must match cwd before any tool call.
- Use \`session_id\` from boot — never hardcode.
- Refresh \`workflow\` after every \`minder_workflow_*\` call.
- Never mix sessions across repos.
- \`minder_session_list\` only for diagnostics, never routine recovery.

---

## 2. Memory vs Skills — WRITE the right store (mandatory check before every store call)

Before calling \`minder_memory_store\` or \`minder_skill_store\`, ask:

> **"Is this knowledge ONLY applicable to THIS specific project or client?"**
> - YES → \`minder_memory_store\` (project fact, decision, constraint)
> - NO  → \`minder_skill_store\`  (reusable pattern, checklist, convention)

| Content | Correct tool |
|---------|-------------|
| "This project uses cursor-based pagination, not offset" | \`minder_memory_store\` |
| "Auth token TTL is 15 min, non-configurable here" | \`minder_memory_store\` |
| "Payment service only accepts idempotency keys in this repo" | \`minder_memory_store\` |
| Cursor-based pagination pattern for REST APIs (any project) | \`minder_skill_store\` |
| JWT expiry handling checklist | \`minder_skill_store\` |
| SQLAlchemy async session management pattern | \`minder_skill_store\` |

**WRONG ✗**: \`minder_skill_store("this project uses PostgreSQL")\` — that is a project fact → use \`minder_memory_store\`.
**WRONG ✗**: \`minder_memory_store("async SQLAlchemy session pattern")\` — that is a reusable skill → use \`minder_skill_store\`.

---

## 3. Lifecycle

### Phase B — Context Discovery
Before any implementation, call the following. Always pass \`session_id\` — it writes results to session history so \`minder_query\` sees them as context:

| Tool | Pass session_id | Skip when |
|------|----------------|-----------|
| \`minder_memory_recall(query=..., session_id=session_id)\` | Yes | Never |
| \`minder_skill_recall(query=..., current_step=current_step, session_id=session_id)\` | Yes | Never |
| \`minder_search_code\` | N/A | Never |
| \`minder_search_errors\` | N/A | Purely additive isolated work only |
| \`minder_find_impact\` | N/A | No existing code modified |
| \`minder_search_graph\` | N/A | No cross-module changes |

\`[TRACE] PHASE-B | <purpose> | <tool> | <summary>\` per call.
> **GATE**: No Phase C until Phase B is complete.

### Phase C — Implementation
1. Every file path and symbol must be confirmed via \`minder_search_code\` / \`minder_search_graph\`. Never guess.
2. Follow recalled skill patterns exactly. Deviations → emit \`[TRACE] PHASE-C | skill_deviation | none | reason=<why>\`.
3. Workflow guard: call \`minder_workflow_guard(repo_id=<repo_id>, requested_step=<step>)\` before each significant action.
   - \`passed=true\` → proceed.
   - \`passed=false\` → **STOP**, surface \`reason\` + \`violations\`, wait for user.
   - Never call \`minder_workflow_update\` speculatively.
   \`[TRACE] PHASE-C | guard_check | minder_workflow_guard | passed=<t/f>\`
4. \`minder_session_save\` after each significant change (no batching).
5. Confirm \`(repo_path, session_id, workflow.id)\` tuple before every write.

### Phase D — Finalization (ALL required, in order)

**D1** — \`minder_workflow_update\` per required artifact (one call per artifact name).
\`[TRACE] PHASE-D | artifact_submit | minder_workflow_update | artifact=<name>\`

**D2** — \`minder_workflow_update\` to mark step complete.
\`[TRACE] PHASE-D | advance_workflow | minder_workflow_update | new_step=<next>\`

**D3 — memory_store** (project-specific facts ONLY): decisions made, constraints found, gotchas, wrong assumptions, and dependency discoveries that are SPECIFIC to this repo.
Apply §2 decision check before each call — do NOT store reusable patterns here.
If nothing project-specific: \`[TRACE] PHASE-D | memory_store | skipped | reason=<specific>\`

**D4 — skill_store** (reusable patterns ONLY): patterns, checklists, or conventions written or discovered that would benefit other projects.
Apply §2 decision check before each call — do NOT store project facts here.
If nothing reusable: \`[TRACE] PHASE-D | skill_store | skipped | reason=<specific>\`

**D5** — \`minder_session_save(session_id=..., state={task, step, next_steps, key_decisions}, branch=..., open_files=[...])\`.
Pass \`branch\` and \`open_files\` here — no separate context call needed.
\`[TRACE] PHASE-D | session_save | minder_session_save | ok\`

**D6** — Write \`.minder/agent.json\` with new \`current_step\`, \`repo_id\`, and \`updated_at\`.
\`[TRACE] PHASE-D | update_ledger | none | current_step=<step>\`

**D7 — Finalization Checklist** (output verbatim, YES/NO with reason if NO):
\`\`\`
□ D1 artifact_submit  □ D2 advance_workflow  □ D3 memory_store (project facts only)
□ D4 skill_store (reusable only)  □ D5 session_save  □ D6 ledger_updated
\`\`\`
> No final response until this checklist is complete.

---

## 4. Tool Rules

- **Never call any Minder tool without a cached \`session_id\`** — call \`minder_session_boot\` first, always.
- Never guess paths/symbols — always verify via search tools.
- Never use \`minder_session_list\` for routine recovery — use \`minder_session_boot\`.
- Always emit \`[TRACE]\` lines — they are the audit trail.
- **ALWAYS keep \`(repo_path, session_id, workflow.id)\` consistent** across all tool calls.
- If search is empty/stale → tell user to run \`minder sync\`.
- **Pass \`session_id\` to \`minder_skill_recall\` and \`minder_memory_recall\`** — writes context to session history so \`minder_query\` sees it without re-fetching. Without \`session_id\`, recalled data is lost after \`/compact\`.
- **Do NOT call \`minder_auth_whoami\` during normal work** — \`minder_session_boot\` already confirms auth. Only call it to inspect available scopes explicitly.
- **Use \`minder_workflow_step(include_definition=true)\` once at session start** to get the full workflow definition; subsequent calls omit \`include_definition\`.

### session_id continuity examples
\`\`\`
# Boot (creates or recovers session — no agent.json needed):
result = minder_session_boot(project_name="my-api", project_context={"repo_path": "/home/dev/my-api"})
session_id = result["session_id"]

# Recall and persist to session so minder_query sees it:
minder_skill_recall(query="NestJS patterns", current_step="implementation", session_id=session_id)
minder_memory_recall(query="auth decisions for this project", session_id=session_id)

# Later minder_query call automatically reads those from session history:
minder_query(query="implement auth middleware", repo_path=repo_path, session_id=session_id)
\`\`\`

---

## 5. SubAgent Delegation (REQUIRED for review and test steps)

When \`current_step\` is \`review\`, \`write_tests\`, or \`verify_tests\`, delegate to a subagent — never do these steps yourself.

| Step | Subagent | Artifacts |
|---|---|---|
| \`review\` | \`code_reviewer\` | \`review_notes\`, \`approval_summary\` |
| \`write_tests\` | \`tester\` | \`failing_tests\`, \`test_plan\` |
| \`verify_tests\` | \`tester\` | \`test_results\` |

**How to delegate:**
1. \`minder_agent_list(workflow_step=<step>)\` — find available subagents.
   \`[TRACE] SUBAGENT | list | minder_agent_list | step=<step>\`
2. \`minder_agent_get(name=<name>)\` — fetch full definition with \`system_prompt\` and \`tools\`.
   \`[TRACE] SUBAGENT | fetch | minder_agent_get | name=<name>\`
3. Spawn subagent using the returned \`system_prompt\`. Restrict it to only the \`tools\` list. Pass \`session_id\`, \`repo_path\`, \`workflow.current_step\`, and \`instruction_envelope\`.
   \`[TRACE] SUBAGENT | spawn | <name> | session_id=<id>, step=<step>\`

If no subagent exists for the step, create one first:
\`\`\`
minder_agent_store(name=<slug>, title=..., description=..., system_prompt=...,
  tools=[...], workflow_steps=[<step>], artifact_types=[...], is_default=False)
\`\`\`
\`[TRACE] SUBAGENT | create | minder_agent_store | name=<name>\``;

const CLAUDE_CODE_FRONT_MATTER = `---
name: minder
description: Minder is your agentic engineering copilot for repo-aware development, workflow governance, and persistent session continuity.
---`;

const ANTIGRAVITY_FRONT_MATTER = `---
description: Minder is your agentic engineering copilot for repo-aware development, workflow governance, and persistent session continuity.
---`;

type IdeTarget = {
  id: string;
  title: string;
  path: string;
  scope: string;
  note: string;
  frontMatter?: string;
  content: string;
};

const ideTargets: IdeTarget[] = [
  {
    id: "claude_code",
    title: "Claude Code",
    path: "~/.claude/agents/minder.md",
    scope: "Global — all repos",
    note: "Saved to the user-level Claude Code agents directory. The agent is active across all projects without any per-repo setup.",
    frontMatter: CLAUDE_CODE_FRONT_MATTER,
    content: `${CLAUDE_CODE_FRONT_MATTER}\n\n${MINDER_AGENT_PROMPT}`,
  },
  {
    id: "cursor",
    title: "Cursor",
    path: ".cursor/rules/minder.mdc",
    scope: "Per-repo",
    note: "Place in the project root. Cursor reads .mdc rule files from .cursor/rules/ automatically.",
    content: MINDER_AGENT_PROMPT,
  },
  {
    id: "vscode",
    title: "VS Code / GitHub Copilot",
    path: "~/.copilot/agents/minder.agent.md",
    scope: "Global — all repos",
    note: "Saved to the user-level Copilot agents directory. Active for all workspaces using Copilot Chat in agent mode.",
    content: MINDER_AGENT_PROMPT,
  },
  {
    id: "antigravity",
    title: "Google Antigravity",
    path: "~/.gemini/GEMINI.md",
    scope: "Global — all repos",
    note: "Antigravity reads GEMINI.md from the user home directory.",
    frontMatter: ANTIGRAVITY_FRONT_MATTER,
    content: `${ANTIGRAVITY_FRONT_MATTER}\n\n${MINDER_AGENT_PROMPT}`,
  },
  {
    id: "codex",
    title: "OpenAI Codex",
    path: "~/.codex/AGENTS.md",
    scope: "Global — all repos",
    note: "Codex reads AGENTS.md from the user home .codex directory. Applies to all Codex sessions.",
    content: MINDER_AGENT_PROMPT,
  },
];

// Serialize for client-side copy — embed as JSON in a script tag to avoid
// HTML attribute encoding issues with large multi-line content.
const ideTargetsJson = JSON.stringify(
  ideTargets.map(({ id, content }) => ({ id, content })),
);
---

<DashboardLayout
  title="Agent Instructions · Minder"
  description="Minder agent orchestration rules for IDE integration — copy-ready for Claude Code, Cursor, VS Code, and Codex."
  navTitle="Minder Dashboard"
  navDescription="Distribute the Minder agent prompt to your IDE without running CLI install commands."
  sessionControls={true}
  showPageIntro={false}
>
  <PageHero
    eyebrow="Agent Instructions"
    title="Minder Agent Orchestration Rules"
    description="Copy the agent prompt directly into your IDE's instruction file. No CLI install commands needed — choose your IDE below and paste the content into the target path shown."
  />

  <!-- Quick copy top bar -->
  <section
    class="shell-card flex flex-wrap items-center justify-between gap-4 px-6 py-4 mb-6"
  >
    <div>
      <p class="text-sm font-medium text-stone-900">Full prompt</p>
      <p class="mt-0.5 text-sm text-stone-600">
        Copy the raw prompt without any IDE-specific front matter.
      </p>
    </div>
    <button id="copy-raw-prompt" type="button" class="action-pill">
      Copy raw prompt
    </button>
  </section>

  <!-- Per-IDE cards -->
  <div class="grid gap-4">
    {
      ideTargets.map((target) => (
        <details
          class="snippet-card rounded-3xl border border-stone-300 bg-stone-50/80 p-5 open:border-amber-300 open:bg-amber-50/40"
          id={`ide-card-${target.id}`}
        >
          <summary class="flex cursor-pointer list-none flex-wrap items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-4">
              <div>
                <h3 class="text-sm font-semibold uppercase tracking-[0.16em] text-amber-800">
                  {target.title}
                </h3>
                <div class="mt-2 flex flex-wrap items-center gap-3">
                  <code class="rounded-lg bg-stone-100 px-2 py-1 text-xs font-mono text-stone-700">
                    {target.path}
                  </code>
                  <span class="inline-flex items-center rounded-full bg-white border border-stone-200 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-[0.18em] text-stone-600">
                    {target.scope}
                  </span>
                </div>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <button
                type="button"
                class="action-pill ide-copy-btn"
                data-ide-id={target.id}
              >
                Copy for {target.title}
              </button>
              <span class="action-pill" data-toggle-label={target.id}>
                Expand
              </span>
            </div>
          </summary>

          <div class="mt-4 border-t border-stone-200 pt-4 grid gap-4">
            <p class="text-sm leading-6 text-stone-600">{target.note}</p>

            {target.frontMatter && (
              <div class="rounded-2xl border border-amber-200 bg-amber-50/60 p-4">
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-900 mb-2">
                  Front matter required
                </p>
                <pre class="overflow-x-auto whitespace-pre-wrap rounded-xl bg-white px-4 py-3 text-xs leading-6 text-stone-700 font-mono">
                  {target.frontMatter}
                </pre>
              </div>
            )}

            <pre class="snippet-pre overflow-x-auto whitespace-pre-wrap rounded-2xl bg-white px-4 py-4 text-sm leading-7 text-stone-700 max-h-96">
              {target.content}
            </pre>
          </div>
        </details>
      ))
    }
  </div>

  <!-- Prompt content embedded as JSON for safe client-side access -->
  <script
    is:inline
    id="ide-targets-data"
    type="application/json"
    set:html={ideTargetsJson}
  />
  <script
    is:inline
    id="raw-prompt-data"
    type="application/json"
    set:html={JSON.stringify(MINDER_AGENT_PROMPT)}
  />

  <script>
    // Toggle labels
    document
      .querySelectorAll<HTMLDetailsElement>("details[id^='ide-card-']")
      .forEach((card) => {
        const id = card.id.replace("ide-card-", "");
        const label = card.querySelector<HTMLElement>(
          `[data-toggle-label="${id}"]`,
        );
        if (!label) return;
        const update = () => {
          label.textContent = card.open ? "Collapse" : "Expand";
        };
        update();
        card.addEventListener("toggle", update);
      });

    // Load content map
    const targetsEl = document.getElementById("ide-targets-data");
    const rawPromptEl = document.getElementById("raw-prompt-data");
    const contentMap: Record<string, string> = {};

    if (targetsEl) {
      try {
        const targets = JSON.parse(targetsEl.textContent ?? "[]") as Array<{
          id: string;
          content: string;
        }>;
        for (const t of targets) contentMap[t.id] = t.content;
      } catch {
        /* ignore */
      }
    }

    let rawPrompt = "";
    if (rawPromptEl) {
      try {
        rawPrompt = JSON.parse(rawPromptEl.textContent ?? '""') as string;
      } catch {
        /* ignore */
      }
    }

    const copyText = async (
      text: string,
      btn: HTMLButtonElement,
      successLabel: string,
    ) => {
      const original = btn.textContent ?? "";
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = successLabel;
        window.setTimeout(() => {
          btn.textContent = original;
        }, 1500);
      } catch {
        btn.textContent = "Copy failed";
        window.setTimeout(() => {
          btn.textContent = original;
        }, 1500);
      }
    };

    // IDE copy buttons
    document
      .querySelectorAll<HTMLButtonElement>(".ide-copy-btn")
      .forEach((btn) => {
        btn.addEventListener("click", async (e) => {
          e.stopPropagation();
          const id = btn.dataset.ideId ?? "";
          const content = contentMap[id] ?? "";
          if (content) await copyText(content, btn, "Copied!");
        });
      });

    // Raw prompt copy
    document
      .getElementById("copy-raw-prompt")
      ?.addEventListener("click", async (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        await copyText(rawPrompt, btn, "Copied!");
      });
  </script>
</DashboardLayout>
