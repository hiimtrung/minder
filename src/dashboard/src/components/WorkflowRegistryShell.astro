---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import PageHero from "./ui/molecules/PageHero.astro";
import Toolbar from "./ui/molecules/Toolbar.astro";
import Field from "./ui/atoms/Field.astro";
import Input from "./ui/atoms/Input.astro";
import Textarea from "./ui/atoms/Textarea.astro";
import Select from "./ui/atoms/Select.astro";
import Button from "./ui/atoms/Button.astro";
import FormStatus from "./ui/atoms/FormStatus.astro";
import StepModal from "./StepModal.astro";
---

<DashboardLayout
  title="Workflow Registry · Minder"
  description="Manage workflow definitions — create, edit, and assign TDD/review workflows to repositories."
  navTitle="Minder Dashboard"
  navDescription="Define and manage the step-gated workflows that govern your AI agent's delivery process."
  sessionControls={true}
  showPageIntro={false}
>
  <PageHero
    eyebrow="Workflow Registry"
    title="Manage delivery workflows."
    description="Create step-gated workflows that control how Minder guides AI agents through your development process. Assign workflows to repositories and track their progress from a single view."
  />

  <div class="flex flex-col gap-5">
    <Toolbar
      idPrefix="workflow"
      description="Open any workflow card to edit steps, change enforcement, or review which repositories are using it."
      searchPlaceholder="Semantic quick search workflows"
    >
      <Button slot="leading" href="/dashboard" size="sm">
        Dashboard home
      </Button>
      <Button slot="leading" id="workflow-new-button" size="sm" variant="primary">
        New workflow
      </Button>
    </Toolbar>

    <div id="workflow-registry" class="u-registry-card-grid grid gap-4 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      <article class="u-placeholder-card" aria-hidden="true"><div class="flex flex-col gap-3"><div class="skeleton h-2.5 w-10 rounded"></div><div class="skeleton h-5 w-4/5 rounded-md"></div><div class="skeleton h-3.5 w-full rounded"></div><div class="skeleton h-3.5 w-3/4 rounded"></div><div class="mt-2 flex gap-2"><div class="skeleton h-4 w-12 rounded-full"></div><div class="skeleton h-4 w-10 rounded-full"></div></div></div></article>
      <article class="u-placeholder-card" aria-hidden="true"><div class="flex flex-col gap-3"><div class="skeleton h-2.5 w-14 rounded"></div><div class="skeleton h-5 w-3/5 rounded-md"></div><div class="skeleton h-3.5 w-full rounded"></div><div class="skeleton h-3.5 w-5/6 rounded"></div><div class="mt-2 flex gap-2"><div class="skeleton h-4 w-8 rounded-full"></div><div class="skeleton h-4 w-14 rounded-full"></div></div></div></article>
      <article class="u-placeholder-card" aria-hidden="true"><div class="flex flex-col gap-3"><div class="skeleton h-2.5 w-8 rounded"></div><div class="skeleton h-5 w-2/3 rounded-md"></div><div class="skeleton h-3.5 w-full rounded"></div><div class="skeleton h-3.5 w-4/5 rounded"></div><div class="mt-2 flex gap-2"><div class="skeleton h-4 w-10 rounded-full"></div><div class="skeleton h-4 w-12 rounded-full"></div></div></div></article>
      <article class="u-placeholder-card" aria-hidden="true"><div class="flex flex-col gap-3"><div class="skeleton h-2.5 w-12 rounded"></div><div class="skeleton h-5 w-3/4 rounded-md"></div><div class="skeleton h-3.5 w-full rounded"></div><div class="skeleton h-3.5 w-2/3 rounded"></div><div class="mt-2 flex gap-2"><div class="skeleton h-4 w-14 rounded-full"></div><div class="skeleton h-4 w-8 rounded-full"></div></div></div></article>
    </div>
  </div>

  <!-- Create workflow dialog -->
  <dialog id="workflow-form-dialog" class="u-modal-dialog">
    <div class="u-modal-inner">
      <header class="u-modal-header">
        <div>
          <p class="eyebrow">Create Workflow</p>
          <h2 class="u-modal-title">New workflow definition</h2>
        </div>
        <button
          id="workflow-close-dialog"
          type="button"
          class="u-modal-close-btn"
          aria-label="Close"
        >
          ✕
        </button>
      </header>

      <div class="u-modal-body">
        <p class="mb-4 text-sm leading-6 text-stone-600">
          Define a named sequence of steps with optional gate conditions. Steps
          are enforced in order; an agent cannot advance until each gate passes.
        </p>

        <form id="create-workflow-form" class="grid gap-4">
          <Field label="Name" htmlFor="workflow-name">
            <Input id="workflow-name" placeholder="tdd, review" />
          </Field>
          <Field label="Description" htmlFor="workflow-description">
            <Textarea id="workflow-description" placeholder="Description" />
          </Field>

          <Field label="Enforcement" htmlFor="workflow-enforcement">
            <Select id="workflow-enforcement">
              <option value="strict">Strict — block on gate failure</option>
              <option value="advisory">Advisory — warn only</option>
              <option value="off">Off — no enforcement</option>
            </Select>
          </Field>

          <div class="grid gap-2 text-sm text-stone-700">
            <div class="flex items-center justify-between gap-2">
              <span class="u-field-label mb-0">Steps</span>
              <Button id="add-step-button" size="sm" variant="ghost">
                + Add step
              </Button>
            </div>
            <div id="workflow-steps-list" class="grid gap-2">
              <p class="px-1 text-xs text-stone-400">
                No steps yet — add the first one above.
              </p>
            </div>
          </div>

          <FormStatus id="create-workflow-status" />
        </form>
      </div>

      <div class="u-modal-footer">
        <Button type="submit" form="create-workflow-form" variant="primary" class="flex-1 min-w-[180px]">
          Create workflow
        </Button>
      </div>
    </div>
  </dialog>

  <StepModal />
  <script src="../scripts/workflows-page.ts"></script>
</DashboardLayout>
