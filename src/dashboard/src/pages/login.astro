---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import Card from "../components/ui/atoms/Card.astro";
import Field from "../components/ui/atoms/Field.astro";
import Input from "../components/ui/atoms/Input.astro";
import Button from "../components/ui/atoms/Button.astro";
import FormStatus from "../components/ui/atoms/FormStatus.astro";
import PageHero from "../components/ui/molecules/PageHero.astro";
---

<DashboardLayout
  title="Admin Login · Minder"
  description="Browser login shell for the Astro-based Minder dashboard."
  navTitle="Minder Admin Login"
  navDescription="Sign in with your username and password to open the dashboard."
  navLinks={[]}
  showPageIntro={false}
>
  <section class="u-split-hero">
    <div class="u-split-hero-copy">
      <PageHero
        eyebrow="Admin Access"
        title="Sign into Minder without leaving the browser."
        description="The dashboard uses an HttpOnly cookie-backed admin session. Sign in with your username and password, then manage clients, workflows, and activity from one place."
        class="mb-0"
      />
    </div>

    <Card padding="lg">
      <div class="mb-5">
        <p class="eyebrow">Admin Login</p>
        <h2
          class="font-display mt-2 text-xl font-semibold tracking-tight text-stone-950"
        >
          Sign in with username &amp; password
        </h2>
      </div>

      <form id="login-form" class="space-y-4">
        <Field label="Username" htmlFor="login-username">
          <Input
            id="login-username"
            type="text"
            autocomplete="username"
            placeholder="admin"
          />
        </Field>
        <Field label="Password" htmlFor="login-password">
          <Input
            id="login-password"
            type="password"
            autocomplete="current-password"
            placeholder="••••••••"
          />
        </Field>
        <FormStatus id="login-status" />
        <Button type="submit" variant="primary" fullWidth>
          Continue to dashboard
        </Button>
      </form>

      <details class="mt-5">
        <summary
          class="cursor-pointer select-none text-sm text-stone-500 hover:text-stone-700"
        >
          Sign in with API key instead
        </summary>
        <form id="apikey-form" class="mt-4 space-y-3">
          <Field label="Admin API key" htmlFor="api-key">
            <Input id="api-key" type="password" placeholder="mk_..." />
          </Field>
          <FormStatus id="apikey-status" />
          <Button type="submit" fullWidth>Sign in with API key</Button>
        </form>
      </details>

      <p id="setup-hint" class="mt-5 hidden text-center text-sm text-stone-500">
        Fresh install?
        <a
          href="/dashboard/setup"
          class="font-medium text-amber-800 hover:underline"
          >Complete first-time setup →</a
        >
      </p>
    </Card>
  </section>

  <!-- Collapsible Diagnostics Drawer -->
  <div class="w-full mt-10 max-w-5xl mx-auto diagnostics-drawer" id="diagnostics-drawer">
    <button
      id="diagnostics-toggle"
      class="flex items-center justify-between w-full px-5 py-3.5 bg-stone-100 hover:bg-stone-200/80 border border-stone-200 rounded-xl transition-all duration-200"
      aria-expanded="false"
      aria-controls="diagnostics-panel"
      type="button"
    >
      <div class="flex items-center gap-3">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
          <span id="diagnostics-status-dot" class="relative inline-flex rounded-full h-2.5 w-2.5 bg-amber-500"></span>
        </span>
        <span class="font-display font-medium text-sm text-stone-700 tracking-tight">Connection Diagnostics &amp; Live Logs</span>
      </div>
      <div class="flex items-center gap-2">
        <span id="diagnostics-summary-text" class="text-xs text-stone-500 font-medium">Checking connectivity...</span>
        <svg id="diagnostics-chevron" class="w-4 h-4 text-stone-500 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </div>
    </button>

    <div id="diagnostics-panel" class="hidden mt-3 p-5 bg-white border border-stone-200 rounded-xl shadow-sm space-y-5 transition-all">
      <!-- Parameters Row -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="p-3 bg-stone-50 border border-stone-100 rounded-lg">
          <div class="text-[10px] font-extrabold tracking-wider text-stone-400 uppercase">Frontend Origin</div>
          <div class="mt-1 font-mono text-xs font-semibold text-stone-700 truncate" id="diag-fe-origin">Loading...</div>
        </div>
        <div class="p-3 bg-stone-50 border border-stone-100 rounded-lg">
          <div class="text-[10px] font-extrabold tracking-wider text-stone-400 uppercase">Backend Base URL</div>
          <div class="mt-1 font-mono text-xs font-semibold text-stone-700 truncate" id="diag-be-url">Loading...</div>
        </div>
        <div class="p-3 bg-stone-50 border border-stone-100 rounded-lg">
          <div class="text-[10px] font-extrabold tracking-wider text-stone-400 uppercase">Ping Latency</div>
          <div class="mt-1 font-mono text-xs font-semibold text-stone-700" id="diag-ping">Loading...</div>
        </div>
        <div class="p-3 bg-stone-50 border border-stone-100 rounded-lg">
          <div class="text-[10px] font-extrabold tracking-wider text-stone-400 uppercase">Python Environment</div>
          <div class="mt-1 font-mono text-xs font-semibold text-stone-700 truncate" id="diag-py-env">Loading...</div>
        </div>
      </div>

      <!-- Live Terminals Split Pane -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <!-- Frontend Terminal -->
        <div class="flex flex-col h-80 bg-stone-900 border border-stone-950 rounded-lg overflow-hidden shadow-inner">
          <div class="flex items-center justify-between px-4 py-2 bg-stone-800 border-b border-stone-950">
            <span class="text-[10px] font-extrabold tracking-wider text-stone-400 uppercase">Frontend Console &amp; Fetch Logs</span>
            <span class="flex h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
          </div>
          <div class="flex-1 p-4 font-mono text-[11px] text-stone-300 overflow-y-auto space-y-1 select-text scrollbar-thin" id="fe-terminal-viewport">
            <div class="text-stone-500">[Info] Diagnostics console initialized. Intercepting window console...</div>
          </div>
        </div>

        <!-- Backend Terminal -->
        <div class="flex flex-col h-80 bg-stone-900 border border-stone-950 rounded-lg overflow-hidden shadow-inner">
          <div class="flex items-center justify-between px-4 py-2 bg-stone-800 border-b border-stone-950">
            <span class="text-[10px] font-extrabold tracking-wider text-stone-400 uppercase">Python Backend (Minder Server) Logs</span>
            <span id="be-status-indicator" class="flex h-1.5 w-1.5 rounded-full bg-amber-500"></span>
          </div>
          <div class="flex-1 p-4 font-mono text-[11px] text-stone-300 overflow-y-auto space-y-1 select-text scrollbar-thin" id="be-terminal-viewport">
            <div class="text-stone-500">[Info] Waiting for backend polling startup...</div>
          </div>
        </div>
      </div>

      <!-- Action Footer -->
      <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-stone-100">
        <div class="flex gap-2">
          <button id="diagnostics-clear" class="px-3.5 py-1.5 bg-stone-50 hover:bg-stone-150 border border-stone-200 text-stone-600 text-xs font-semibold rounded-lg shadow-sm transition-all" type="button">
            Clear Logs
          </button>
          <button id="diagnostics-copy" class="px-3.5 py-1.5 bg-amber-50 hover:bg-amber-100/80 border border-amber-200 text-amber-800 text-xs font-semibold rounded-lg shadow-sm transition-all" type="button">
            Copy Diagnostics Report
          </button>
        </div>
        <div class="text-[10px] text-stone-400 font-medium tracking-tight">
          Note: Diagnostics console polls unauthenticated endpoint `/v1/admin/diagnostics/logs`.
        </div>
      </div>
    </div>
  </div>

  <script src="../scripts/login-page.ts"></script>
</DashboardLayout>
